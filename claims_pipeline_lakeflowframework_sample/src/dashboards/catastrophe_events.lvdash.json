{
  "datasets": [
    {
      "name": "event_loss",
      "displayName": "Event loss summary",
      "query": "SELECT\n  claim_category,\n  COALESCE(event_name, 'Non-Catastrophe') AS event_name,\n  event_start,\n  event_end,\n  event_duration_days,\n  region_name,\n  peril_type,\n  claim_count,\n  total_incurred,\n  avg_claim_severity,\n  max_claim_severity,\n  total_paid,\n  outstanding_reserve\nFROM event_loss_summary"
    }
  ],
  "pages": [
    {
      "name": "main",
      "displayName": "Catastrophe Events",
      "layout": [
        {
          "position": { "x": 0, "y": 0, "width": 6, "height": 1 },
          "widget": {
            "name": "title",
            "textbox_spec": "# Catastrophe Event Losses\nCat vs non-cat incurred, severity, and settlement by named cyclone event and region."
          }
        },
        {
          "position": { "x": 0, "y": 1, "width": 2, "height": 1 },
          "widget": {
            "name": "filter_category",
            "queries": [
              {
                "name": "filter_q",
                "query": {
                  "datasetName": "event_loss",
                  "fields": [
                    { "name": "claim_category", "expression": "`claim_category`" },
                    { "name": "claim_category_associativity", "expression": "COUNT_IF(`associative_filter_predicate_group`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  { "fieldName": "claim_category", "displayName": "Category", "queryName": "filter_q" }
                ]
              },
              "frame": { "showTitle": true, "title": "Claim category" }
            }
          }
        },
        {
          "position": { "x": 2, "y": 1, "width": 2, "height": 1 },
          "widget": {
            "name": "filter_event",
            "queries": [
              {
                "name": "filter_q",
                "query": {
                  "datasetName": "event_loss",
                  "fields": [
                    { "name": "event_name", "expression": "`event_name`" },
                    { "name": "event_name_associativity", "expression": "COUNT_IF(`associative_filter_predicate_group`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  { "fieldName": "event_name", "displayName": "Event", "queryName": "filter_q" }
                ]
              },
              "frame": { "showTitle": true, "title": "Event name" }
            }
          }
        },
        {
          "position": { "x": 4, "y": 1, "width": 2, "height": 1 },
          "widget": {
            "name": "filter_region",
            "queries": [
              {
                "name": "filter_q",
                "query": {
                  "datasetName": "event_loss",
                  "fields": [
                    { "name": "region_name", "expression": "`region_name`" },
                    { "name": "region_name_associativity", "expression": "COUNT_IF(`associative_filter_predicate_group`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  { "fieldName": "region_name", "displayName": "Region", "queryName": "filter_q" }
                ]
              },
              "frame": { "showTitle": true, "title": "Region" }
            }
          }
        },
        {
          "position": { "x": 0, "y": 2, "width": 2, "height": 2 },
          "widget": {
            "name": "kpi_cat_incurred",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "event_loss",
                  "fields": [
                    {
                      "name": "cat_incurred",
                      "expression": "SUM(CASE WHEN `claim_category` = 'Catastrophe' THEN `total_incurred` ELSE 0 END)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": { "fieldName": "cat_incurred", "displayName": "Cat incurred" }
              },
              "frame": { "showTitle": true, "title": "Catastrophe incurred" }
            }
          }
        },
        {
          "position": { "x": 2, "y": 2, "width": 2, "height": 2 },
          "widget": {
            "name": "kpi_noncat_incurred",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "event_loss",
                  "fields": [
                    {
                      "name": "noncat_incurred",
                      "expression": "SUM(CASE WHEN `claim_category` = 'Non-Catastrophe' THEN `total_incurred` ELSE 0 END)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": { "fieldName": "noncat_incurred", "displayName": "Non-cat incurred" }
              },
              "frame": { "showTitle": true, "title": "Non-catastrophe incurred" }
            }
          }
        },
        {
          "position": { "x": 4, "y": 2, "width": 2, "height": 2 },
          "widget": {
            "name": "kpi_claims",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "event_loss",
                  "fields": [
                    { "name": "sum_claims", "expression": "SUM(`claim_count`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": { "fieldName": "sum_claims", "displayName": "Claims" }
              },
              "frame": { "showTitle": true, "title": "Total claims" }
            }
          }
        },
        {
          "position": { "x": 0, "y": 4, "width": 3, "height": 4 },
          "widget": {
            "name": "pie_cat_split",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "event_loss",
                  "fields": [
                    { "name": "claim_category", "expression": "`claim_category`" },
                    { "name": "incurred", "expression": "SUM(`total_incurred`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "pie",
              "encodings": {
                "angle": { "fieldName": "incurred", "displayName": "Incurred" },
                "color": {
                  "fieldName": "claim_category",
                  "displayName": "Category",
                  "scale": { "type": "categorical" }
                }
              },
              "frame": { "showTitle": true, "title": "Cat vs non-cat incurred" }
            }
          }
        },
        {
          "position": { "x": 3, "y": 4, "width": 3, "height": 4 },
          "widget": {
            "name": "bar_incurred_event",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "event_loss",
                  "fields": [
                    { "name": "event_name", "expression": "`event_name`" },
                    { "name": "total_incurred", "expression": "SUM(`total_incurred`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "total_incurred",
                  "displayName": "Incurred",
                  "scale": { "type": "quantitative" }
                },
                "y": {
                  "fieldName": "event_name",
                  "displayName": "Event",
                  "scale": { "type": "categorical" }
                }
              },
              "frame": { "showTitle": true, "title": "Incurred by named cyclone event" }
            }
          }
        },
        {
          "position": { "x": 0, "y": 8, "width": 3, "height": 4 },
          "widget": {
            "name": "bar_severity_event",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "event_loss",
                  "fields": [
                    { "name": "event_name", "expression": "`event_name`" },
                    {
                      "name": "avg_severity",
                      "expression": "ROUND(SUM(`total_incurred`) / NULLIF(SUM(`claim_count`), 0), 2)"
                    },
                    { "name": "max_severity", "expression": "MAX(`max_claim_severity`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "event_name",
                  "displayName": "Event",
                  "scale": { "type": "categorical" }
                },
                "y": {
                  "fieldName": "avg_severity",
                  "displayName": "Avg severity",
                  "scale": { "type": "quantitative" }
                }
              },
              "frame": { "showTitle": true, "title": "Average severity by event" }
            }
          }
        },
        {
          "position": { "x": 3, "y": 8, "width": 3, "height": 4 },
          "widget": {
            "name": "bar_paid_reserve_event",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "event_loss",
                  "fields": [
                    { "name": "event_name", "expression": "`event_name`" },
                    { "name": "total_paid", "expression": "SUM(`total_paid`)" },
                    { "name": "outstanding_reserve", "expression": "SUM(`outstanding_reserve`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "event_name",
                  "displayName": "Event",
                  "scale": { "type": "categorical" }
                },
                "y": {
                  "fieldName": "total_paid",
                  "displayName": "Paid",
                  "scale": { "type": "quantitative" }
                },
                "color": {
                  "fieldName": "outstanding_reserve",
                  "displayName": "Outstanding reserve",
                  "scale": { "type": "quantitative" }
                }
              },
              "frame": { "showTitle": true, "title": "Paid vs outstanding by event" }
            }
          }
        },
        {
          "position": { "x": 0, "y": 12, "width": 6, "height": 5 },
          "widget": {
            "name": "table_event_detail",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "event_loss",
                  "fields": [
                    { "name": "claim_category", "expression": "`claim_category`" },
                    { "name": "event_name", "expression": "`event_name`" },
                    { "name": "region_name", "expression": "`region_name`" },
                    { "name": "peril_type", "expression": "`peril_type`" },
                    { "name": "claim_count", "expression": "`claim_count`" },
                    { "name": "total_incurred", "expression": "`total_incurred`" },
                    { "name": "avg_claim_severity", "expression": "`avg_claim_severity`" },
                    { "name": "max_claim_severity", "expression": "`max_claim_severity`" },
                    { "name": "total_paid", "expression": "`total_paid`" },
                    { "name": "outstanding_reserve", "expression": "`outstanding_reserve`" }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 1,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  { "fieldName": "claim_category", "type": "string", "displayAs": "string", "visible": true, "order": 1, "title": "Category", "displayName": "Category" },
                  { "fieldName": "event_name", "type": "string", "displayAs": "string", "visible": true, "order": 2, "title": "Event", "displayName": "Event" },
                  { "fieldName": "region_name", "type": "string", "displayAs": "string", "visible": true, "order": 3, "title": "Region", "displayName": "Region" },
                  { "fieldName": "peril_type", "type": "string", "displayAs": "string", "visible": true, "order": 4, "title": "Peril", "displayName": "Peril" },
                  { "fieldName": "claim_count", "type": "integer", "displayAs": "number", "visible": true, "order": 5, "title": "Claims", "displayName": "Claims", "numberFormat": "0" },
                  { "fieldName": "total_incurred", "type": "float", "displayAs": "number", "visible": true, "order": 6, "title": "Incurred", "displayName": "Incurred", "numberFormat": "0,0.00" },
                  { "fieldName": "avg_claim_severity", "type": "float", "displayAs": "number", "visible": true, "order": 7, "title": "Avg severity", "displayName": "Avg severity", "numberFormat": "0,0.00" },
                  { "fieldName": "max_claim_severity", "type": "float", "displayAs": "number", "visible": true, "order": 8, "title": "Max severity", "displayName": "Max severity", "numberFormat": "0,0.00" },
                  { "fieldName": "total_paid", "type": "float", "displayAs": "number", "visible": true, "order": 9, "title": "Paid", "displayName": "Paid", "numberFormat": "0,0.00" },
                  { "fieldName": "outstanding_reserve", "type": "float", "displayAs": "number", "visible": true, "order": 10, "title": "Reserve", "displayName": "Reserve", "numberFormat": "0,0.00" }
                ]
              },
              "frame": { "showTitle": true, "title": "Event losses by region × peril" },
              "itemsPerPage": 25,
              "withRowNumber": false
            }
          }
        }
      ]
    }
  ]
}
