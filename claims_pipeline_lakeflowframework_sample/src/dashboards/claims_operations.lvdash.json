{
  "datasets": [
    {
      "name": "claims_summary",
      "displayName": "Claims summary",
      "query": "SELECT\n  peril_type,\n  claim_status,\n  region_name,\n  wind_risk_band,\n  building_type,\n  claim_count,\n  total_incurred,\n  total_paid,\n  outstanding_reserve,\n  avg_claim_severity,\n  settlement_pct\nFROM claims_summary"
    }
  ],
  "pages": [
    {
      "name": "main",
      "displayName": "Claims Operations",
      "layout": [
        {
          "position": { "x": 0, "y": 0, "width": 6, "height": 1 },
          "widget": {
            "name": "title",
            "textbox_spec": "# Claims Operations & Settlement\nFrequency, severity, and settlement progress by peril, status, and risk dimensions."
          }
        },
        {
          "position": { "x": 0, "y": 1, "width": 2, "height": 1 },
          "widget": {
            "name": "filter_peril",
            "queries": [
              {
                "name": "filter_q",
                "query": {
                  "datasetName": "claims_summary",
                  "fields": [
                    { "name": "peril_type", "expression": "`peril_type`" },
                    { "name": "peril_type_associativity", "expression": "COUNT_IF(`associative_filter_predicate_group`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  { "fieldName": "peril_type", "displayName": "Peril", "queryName": "filter_q" }
                ]
              },
              "frame": { "showTitle": true, "title": "Peril" }
            }
          }
        },
        {
          "position": { "x": 2, "y": 1, "width": 2, "height": 1 },
          "widget": {
            "name": "filter_status",
            "queries": [
              {
                "name": "filter_q",
                "query": {
                  "datasetName": "claims_summary",
                  "fields": [
                    { "name": "claim_status", "expression": "`claim_status`" },
                    { "name": "claim_status_associativity", "expression": "COUNT_IF(`associative_filter_predicate_group`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  { "fieldName": "claim_status", "displayName": "Status", "queryName": "filter_q" }
                ]
              },
              "frame": { "showTitle": true, "title": "Claim status" }
            }
          }
        },
        {
          "position": { "x": 4, "y": 1, "width": 2, "height": 1 },
          "widget": {
            "name": "filter_region",
            "queries": [
              {
                "name": "filter_q",
                "query": {
                  "datasetName": "claims_summary",
                  "fields": [
                    { "name": "region_name", "expression": "`region_name`" },
                    { "name": "region_name_associativity", "expression": "COUNT_IF(`associative_filter_predicate_group`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  { "fieldName": "region_name", "displayName": "Region", "queryName": "filter_q" }
                ]
              },
              "frame": { "showTitle": true, "title": "Region" }
            }
          }
        },
        {
          "position": { "x": 0, "y": 2, "width": 2, "height": 2 },
          "widget": {
            "name": "kpi_claims",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "claims_summary",
                  "fields": [
                    { "name": "sum_claims", "expression": "SUM(`claim_count`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": { "fieldName": "sum_claims", "displayName": "Claims" }
              },
              "frame": { "showTitle": true, "title": "Total claims" }
            }
          }
        },
        {
          "position": { "x": 2, "y": 2, "width": 2, "height": 2 },
          "widget": {
            "name": "kpi_incurred",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "claims_summary",
                  "fields": [
                    { "name": "sum_incurred", "expression": "SUM(`total_incurred`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": { "fieldName": "sum_incurred", "displayName": "Incurred" }
              },
              "frame": { "showTitle": true, "title": "Total incurred" }
            }
          }
        },
        {
          "position": { "x": 4, "y": 2, "width": 2, "height": 2 },
          "widget": {
            "name": "kpi_reserve",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "claims_summary",
                  "fields": [
                    { "name": "sum_reserve", "expression": "SUM(`outstanding_reserve`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": { "fieldName": "sum_reserve", "displayName": "Reserve" }
              },
              "frame": { "showTitle": true, "title": "Outstanding reserve" }
            }
          }
        },
        {
          "position": { "x": 0, "y": 4, "width": 2, "height": 2 },
          "widget": {
            "name": "kpi_settlement",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "claims_summary",
                  "fields": [
                    {
                      "name": "settlement",
                      "expression": "ROUND(SUM(`total_paid`) / NULLIF(SUM(`total_incurred`), 0) * 100, 2)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": { "fieldName": "settlement", "displayName": "Settlement %" }
              },
              "frame": { "showTitle": true, "title": "Settlement %" }
            }
          }
        },
        {
          "position": { "x": 2, "y": 4, "width": 4, "height": 4 },
          "widget": {
            "name": "pie_status",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "claims_summary",
                  "fields": [
                    { "name": "claim_status", "expression": "`claim_status`" },
                    { "name": "claims", "expression": "SUM(`claim_count`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "pie",
              "encodings": {
                "angle": { "fieldName": "claims", "displayName": "Claims" },
                "color": {
                  "fieldName": "claim_status",
                  "displayName": "Status",
                  "scale": { "type": "categorical" }
                }
              },
              "frame": { "showTitle": true, "title": "Claims by status" }
            }
          }
        },
        {
          "position": { "x": 0, "y": 6, "width": 3, "height": 4 },
          "widget": {
            "name": "bar_freq_severity",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "claims_summary",
                  "fields": [
                    { "name": "peril_type", "expression": "`peril_type`" },
                    { "name": "claim_count", "expression": "SUM(`claim_count`)" },
                    {
                      "name": "avg_severity",
                      "expression": "ROUND(SUM(`total_incurred`) / NULLIF(SUM(`claim_count`), 0), 2)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "peril_type",
                  "displayName": "Peril",
                  "scale": { "type": "categorical" }
                },
                "y": {
                  "fieldName": "claim_count",
                  "displayName": "Claim count",
                  "scale": { "type": "quantitative" }
                }
              },
              "frame": { "showTitle": true, "title": "Claim frequency by peril" }
            }
          }
        },
        {
          "position": { "x": 3, "y": 8, "width": 3, "height": 4 },
          "widget": {
            "name": "bar_severity_peril",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "claims_summary",
                  "fields": [
                    { "name": "peril_type", "expression": "`peril_type`" },
                    {
                      "name": "avg_severity",
                      "expression": "ROUND(SUM(`total_incurred`) / NULLIF(SUM(`claim_count`), 0), 2)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "peril_type",
                  "displayName": "Peril",
                  "scale": { "type": "categorical" }
                },
                "y": {
                  "fieldName": "avg_severity",
                  "displayName": "Avg severity",
                  "scale": { "type": "quantitative" }
                }
              },
              "frame": { "showTitle": true, "title": "Average severity by peril" }
            }
          }
        },
        {
          "position": { "x": 0, "y": 10, "width": 3, "height": 4 },
          "widget": {
            "name": "bar_reserve_region",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "claims_summary",
                  "fields": [
                    { "name": "region_name", "expression": "`region_name`" },
                    { "name": "outstanding_reserve", "expression": "SUM(`outstanding_reserve`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "outstanding_reserve",
                  "displayName": "Outstanding reserve",
                  "scale": { "type": "quantitative" }
                },
                "y": {
                  "fieldName": "region_name",
                  "displayName": "Region",
                  "scale": { "type": "categorical" }
                }
              },
              "frame": { "showTitle": true, "title": "Outstanding reserve by region" }
            }
          }
        },
        {
          "position": { "x": 3, "y": 12, "width": 3, "height": 4 },
          "widget": {
            "name": "bar_settlement_peril",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "claims_summary",
                  "fields": [
                    { "name": "peril_type", "expression": "`peril_type`" },
                    {
                      "name": "settlement_pct",
                      "expression": "ROUND(SUM(`total_paid`) / NULLIF(SUM(`total_incurred`), 0) * 100, 2)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "peril_type",
                  "displayName": "Peril",
                  "scale": { "type": "categorical" }
                },
                "y": {
                  "fieldName": "settlement_pct",
                  "displayName": "Settlement %",
                  "scale": { "type": "quantitative" }
                }
              },
              "frame": { "showTitle": true, "title": "Settlement % by peril" }
            }
          }
        },
        {
          "position": { "x": 0, "y": 14, "width": 6, "height": 5 },
          "widget": {
            "name": "table_detail",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "claims_summary",
                  "fields": [
                    { "name": "peril_type", "expression": "`peril_type`" },
                    { "name": "claim_status", "expression": "`claim_status`" },
                    { "name": "region_name", "expression": "`region_name`" },
                    { "name": "wind_risk_band", "expression": "`wind_risk_band`" },
                    { "name": "building_type", "expression": "`building_type`" },
                    { "name": "claim_count", "expression": "`claim_count`" },
                    { "name": "total_incurred", "expression": "`total_incurred`" },
                    { "name": "total_paid", "expression": "`total_paid`" },
                    { "name": "outstanding_reserve", "expression": "`outstanding_reserve`" },
                    { "name": "avg_claim_severity", "expression": "`avg_claim_severity`" },
                    { "name": "settlement_pct", "expression": "`settlement_pct`" }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 1,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  { "fieldName": "peril_type", "type": "string", "displayAs": "string", "visible": true, "order": 1, "title": "Peril", "displayName": "Peril" },
                  { "fieldName": "claim_status", "type": "string", "displayAs": "string", "visible": true, "order": 2, "title": "Status", "displayName": "Status" },
                  { "fieldName": "region_name", "type": "string", "displayAs": "string", "visible": true, "order": 3, "title": "Region", "displayName": "Region" },
                  { "fieldName": "wind_risk_band", "type": "string", "displayAs": "string", "visible": true, "order": 4, "title": "Wind risk band", "displayName": "Wind risk band" },
                  { "fieldName": "building_type", "type": "string", "displayAs": "string", "visible": true, "order": 5, "title": "Building type", "displayName": "Building type" },
                  { "fieldName": "claim_count", "type": "integer", "displayAs": "number", "visible": true, "order": 6, "title": "Claims", "displayName": "Claims", "numberFormat": "0" },
                  { "fieldName": "total_incurred", "type": "float", "displayAs": "number", "visible": true, "order": 7, "title": "Incurred", "displayName": "Incurred", "numberFormat": "0,0.00" },
                  { "fieldName": "total_paid", "type": "float", "displayAs": "number", "visible": true, "order": 8, "title": "Paid", "displayName": "Paid", "numberFormat": "0,0.00" },
                  { "fieldName": "outstanding_reserve", "type": "float", "displayAs": "number", "visible": true, "order": 9, "title": "Reserve", "displayName": "Reserve", "numberFormat": "0,0.00" },
                  { "fieldName": "avg_claim_severity", "type": "float", "displayAs": "number", "visible": true, "order": 10, "title": "Avg severity", "displayName": "Avg severity", "numberFormat": "0,0.00" },
                  { "fieldName": "settlement_pct", "type": "float", "displayAs": "number", "visible": true, "order": 11, "title": "Settlement %", "displayName": "Settlement %", "numberFormat": "0.00" }
                ]
              },
              "frame": { "showTitle": true, "title": "Claims summary detail" },
              "itemsPerPage": 25,
              "withRowNumber": false
            }
          }
        }
      ]
    }
  ]
}
