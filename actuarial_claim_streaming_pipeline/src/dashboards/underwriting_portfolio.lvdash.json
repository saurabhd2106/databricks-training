{
  "datasets": [
    {
      "name": "loss_ratio",
      "displayName": "Loss ratio by risk",
      "query": "SELECT\n  insurer_name,\n  region_name,\n  wind_risk_band,\n  building_type,\n  mitigation_flag,\n  policy_count,\n  total_premium,\n  claim_count,\n  total_incurred,\n  loss_ratio_pct\nFROM gold_loss_ratio_by_risk"
    },
    {
      "name": "exposure",
      "displayName": "Portfolio exposure",
      "query": "SELECT\n  insurer_name,\n  region_name,\n  wind_risk_band,\n  building_type,\n  mitigation_flag,\n  policy_count,\n  total_sum_insured,\n  total_annual_premium,\n  avg_sum_insured,\n  avg_annual_premium,\n  premium_rate_pct\nFROM gold_portfolio_exposure"
    }
  ],
  "pages": [
    {
      "name": "main",
      "displayName": "Portfolio Performance",
      "layout": [
        {
          "position": { "x": 0, "y": 0, "width": 6, "height": 1 },
          "widget": {
            "name": "title",
            "textbox_spec": "# Underwriting Portfolio Performance\nLoss ratio and exposure by insurer, region, wind risk band, building type, and mitigation."
          }
        },
        {
          "position": { "x": 0, "y": 1, "width": 2, "height": 1 },
          "widget": {
            "name": "filter_insurer",
            "queries": [
              {
                "name": "filter_q",
                "query": {
                  "datasetName": "loss_ratio",
                  "fields": [
                    { "name": "insurer_name", "expression": "`insurer_name`" },
                    { "name": "insurer_name_associativity", "expression": "COUNT_IF(`associative_filter_predicate_group`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "insurer_name",
                    "displayName": "Insurer",
                    "queryName": "filter_q"
                  }
                ]
              },
              "frame": { "showTitle": true, "title": "Insurer" }
            }
          }
        },
        {
          "position": { "x": 2, "y": 1, "width": 2, "height": 1 },
          "widget": {
            "name": "filter_region",
            "queries": [
              {
                "name": "filter_q",
                "query": {
                  "datasetName": "loss_ratio",
                  "fields": [
                    { "name": "region_name", "expression": "`region_name`" },
                    { "name": "region_name_associativity", "expression": "COUNT_IF(`associative_filter_predicate_group`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "region_name",
                    "displayName": "Region",
                    "queryName": "filter_q"
                  }
                ]
              },
              "frame": { "showTitle": true, "title": "Region" }
            }
          }
        },
        {
          "position": { "x": 4, "y": 1, "width": 2, "height": 1 },
          "widget": {
            "name": "filter_risk_band",
            "queries": [
              {
                "name": "filter_q",
                "query": {
                  "datasetName": "loss_ratio",
                  "fields": [
                    { "name": "wind_risk_band", "expression": "`wind_risk_band`" },
                    { "name": "wind_risk_band_associativity", "expression": "COUNT_IF(`associative_filter_predicate_group`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "wind_risk_band",
                    "displayName": "Wind risk band",
                    "queryName": "filter_q"
                  }
                ]
              },
              "frame": { "showTitle": true, "title": "Wind risk band" }
            }
          }
        },
        {
          "position": { "x": 0, "y": 2, "width": 2, "height": 2 },
          "widget": {
            "name": "kpi_premium",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "loss_ratio",
                  "fields": [
                    { "name": "sum_premium", "expression": "SUM(`total_premium`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": { "fieldName": "sum_premium", "displayName": "Total premium" }
              },
              "frame": { "showTitle": true, "title": "Total premium" }
            }
          }
        },
        {
          "position": { "x": 2, "y": 2, "width": 2, "height": 2 },
          "widget": {
            "name": "kpi_policies",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "loss_ratio",
                  "fields": [
                    { "name": "sum_policies", "expression": "SUM(`policy_count`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": { "fieldName": "sum_policies", "displayName": "Policies" }
              },
              "frame": { "showTitle": true, "title": "Policy count" }
            }
          }
        },
        {
          "position": { "x": 4, "y": 2, "width": 2, "height": 2 },
          "widget": {
            "name": "kpi_sum_insured",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "exposure",
                  "fields": [
                    { "name": "sum_si", "expression": "SUM(`total_sum_insured`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": { "fieldName": "sum_si", "displayName": "Sum insured" }
              },
              "frame": { "showTitle": true, "title": "Total sum insured" }
            }
          }
        },
        {
          "position": { "x": 0, "y": 4, "width": 2, "height": 2 },
          "widget": {
            "name": "kpi_loss_ratio",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "loss_ratio",
                  "fields": [
                    {
                      "name": "overall_lr",
                      "expression": "ROUND(SUM(`total_incurred`) / NULLIF(SUM(`total_premium`), 0) * 100, 2)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": { "fieldName": "overall_lr", "displayName": "Loss ratio %" }
              },
              "frame": { "showTitle": true, "title": "Overall loss ratio %" }
            }
          }
        },
        {
          "position": { "x": 2, "y": 4, "width": 4, "height": 4 },
          "widget": {
            "name": "bar_lr_risk_band",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "loss_ratio",
                  "fields": [
                    { "name": "wind_risk_band", "expression": "`wind_risk_band`" },
                    {
                      "name": "loss_ratio",
                      "expression": "ROUND(SUM(`total_incurred`) / NULLIF(SUM(`total_premium`), 0) * 100, 2)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "wind_risk_band",
                  "displayName": "Wind risk band",
                  "scale": { "type": "categorical" }
                },
                "y": {
                  "fieldName": "loss_ratio",
                  "displayName": "Loss ratio %",
                  "scale": { "type": "quantitative" }
                }
              },
              "frame": { "showTitle": true, "title": "Loss ratio by wind risk band" }
            }
          }
        },
        {
          "position": { "x": 0, "y": 6, "width": 3, "height": 4 },
          "widget": {
            "name": "bar_lr_region",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "loss_ratio",
                  "fields": [
                    { "name": "region_name", "expression": "`region_name`" },
                    {
                      "name": "loss_ratio",
                      "expression": "ROUND(SUM(`total_incurred`) / NULLIF(SUM(`total_premium`), 0) * 100, 2)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "loss_ratio",
                  "displayName": "Loss ratio %",
                  "scale": { "type": "quantitative" }
                },
                "y": {
                  "fieldName": "region_name",
                  "displayName": "Region",
                  "scale": { "type": "categorical" }
                }
              },
              "frame": { "showTitle": true, "title": "Loss ratio by region" }
            }
          }
        },
        {
          "position": { "x": 3, "y": 8, "width": 3, "height": 4 },
          "widget": {
            "name": "bar_lr_building_mitigation",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "loss_ratio",
                  "fields": [
                    { "name": "building_type", "expression": "`building_type`" },
                    { "name": "mitigation_flag", "expression": "`mitigation_flag`" },
                    {
                      "name": "loss_ratio",
                      "expression": "ROUND(SUM(`total_incurred`) / NULLIF(SUM(`total_premium`), 0) * 100, 2)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "building_type",
                  "displayName": "Building type",
                  "scale": { "type": "categorical" }
                },
                "y": {
                  "fieldName": "loss_ratio",
                  "displayName": "Loss ratio %",
                  "scale": { "type": "quantitative" }
                },
                "color": {
                  "fieldName": "mitigation_flag",
                  "displayName": "Mitigation",
                  "scale": { "type": "categorical" }
                }
              },
              "frame": { "showTitle": true, "title": "Loss ratio by building type × mitigation" }
            }
          }
        },
        {
          "position": { "x": 0, "y": 10, "width": 3, "height": 4 },
          "widget": {
            "name": "bar_exposure_insurer",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "exposure",
                  "fields": [
                    { "name": "insurer_name", "expression": "`insurer_name`" },
                    { "name": "sum_insured", "expression": "SUM(`total_sum_insured`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "pie",
              "encodings": {
                "angle": {
                  "fieldName": "sum_insured",
                  "displayName": "Sum insured"
                },
                "color": {
                  "fieldName": "insurer_name",
                  "displayName": "Insurer",
                  "scale": { "type": "categorical" }
                }
              },
              "frame": { "showTitle": true, "title": "Exposure mix by insurer" }
            }
          }
        },
        {
          "position": { "x": 3, "y": 12, "width": 3, "height": 4 },
          "widget": {
            "name": "table_rate_by_band",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "exposure",
                  "fields": [
                    { "name": "wind_risk_band", "expression": "`wind_risk_band`" },
                    { "name": "total_sum_insured", "expression": "SUM(`total_sum_insured`)" },
                    { "name": "total_annual_premium", "expression": "SUM(`total_annual_premium`)" },
                    {
                      "name": "premium_rate_pct",
                      "expression": "ROUND(SUM(`total_annual_premium`) / NULLIF(SUM(`total_sum_insured`), 0) * 100, 4)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 1,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "wind_risk_band",
                    "type": "string",
                    "displayAs": "string",
                    "visible": true,
                    "order": 1,
                    "title": "Wind risk band",
                    "displayName": "Wind risk band"
                  },
                  {
                    "fieldName": "total_sum_insured",
                    "type": "float",
                    "displayAs": "number",
                    "visible": true,
                    "order": 2,
                    "title": "Sum insured",
                    "displayName": "Sum insured",
                    "numberFormat": "0,0.00"
                  },
                  {
                    "fieldName": "total_annual_premium",
                    "type": "float",
                    "displayAs": "number",
                    "visible": true,
                    "order": 3,
                    "title": "Premium",
                    "displayName": "Premium",
                    "numberFormat": "0,0.00"
                  },
                  {
                    "fieldName": "premium_rate_pct",
                    "type": "float",
                    "displayAs": "number",
                    "visible": true,
                    "order": 4,
                    "title": "Premium rate %",
                    "displayName": "Premium rate %",
                    "numberFormat": "0.0000"
                  }
                ]
              },
              "frame": { "showTitle": true, "title": "Premium rate vs sum insured by risk band" },
              "itemsPerPage": 25,
              "withRowNumber": false
            }
          }
        },
        {
          "position": { "x": 0, "y": 14, "width": 6, "height": 5 },
          "widget": {
            "name": "table_loss_ratio_detail",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "loss_ratio",
                  "fields": [
                    { "name": "insurer_name", "expression": "`insurer_name`" },
                    { "name": "region_name", "expression": "`region_name`" },
                    { "name": "wind_risk_band", "expression": "`wind_risk_band`" },
                    { "name": "building_type", "expression": "`building_type`" },
                    { "name": "mitigation_flag", "expression": "`mitigation_flag`" },
                    { "name": "policy_count", "expression": "`policy_count`" },
                    { "name": "total_premium", "expression": "`total_premium`" },
                    { "name": "claim_count", "expression": "`claim_count`" },
                    { "name": "total_incurred", "expression": "`total_incurred`" },
                    { "name": "loss_ratio_pct", "expression": "`loss_ratio_pct`" }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 1,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  { "fieldName": "insurer_name", "type": "string", "displayAs": "string", "visible": true, "order": 1, "title": "Insurer", "displayName": "Insurer" },
                  { "fieldName": "region_name", "type": "string", "displayAs": "string", "visible": true, "order": 2, "title": "Region", "displayName": "Region" },
                  { "fieldName": "wind_risk_band", "type": "string", "displayAs": "string", "visible": true, "order": 3, "title": "Wind risk band", "displayName": "Wind risk band" },
                  { "fieldName": "building_type", "type": "string", "displayAs": "string", "visible": true, "order": 4, "title": "Building type", "displayName": "Building type" },
                  { "fieldName": "mitigation_flag", "type": "string", "displayAs": "string", "visible": true, "order": 5, "title": "Mitigation", "displayName": "Mitigation" },
                  { "fieldName": "policy_count", "type": "integer", "displayAs": "number", "visible": true, "order": 6, "title": "Policies", "displayName": "Policies", "numberFormat": "0" },
                  { "fieldName": "total_premium", "type": "float", "displayAs": "number", "visible": true, "order": 7, "title": "Premium", "displayName": "Premium", "numberFormat": "0,0.00" },
                  { "fieldName": "claim_count", "type": "integer", "displayAs": "number", "visible": true, "order": 8, "title": "Claims", "displayName": "Claims", "numberFormat": "0" },
                  { "fieldName": "total_incurred", "type": "float", "displayAs": "number", "visible": true, "order": 9, "title": "Incurred", "displayName": "Incurred", "numberFormat": "0,0.00" },
                  { "fieldName": "loss_ratio_pct", "type": "float", "displayAs": "number", "visible": true, "order": 10, "title": "Loss ratio %", "displayName": "Loss ratio %", "numberFormat": "0.00" }
                ]
              },
              "frame": { "showTitle": true, "title": "Loss ratio detail" },
              "itemsPerPage": 25,
              "withRowNumber": false
            }
          }
        }
      ]
    }
  ]
}
