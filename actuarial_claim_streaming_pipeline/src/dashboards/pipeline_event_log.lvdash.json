{
  "datasets": [
    {
      "name": "update_runs",
      "displayName": "Pipeline update runs",
      "query": "WITH event_log_raw AS (\n  SELECT * FROM actuarial_claim_streaming_etl_event_log\n),\nlast_status_per_update AS (\n  SELECT\n    origin.pipeline_id AS pipeline_id,\n    origin.pipeline_name AS pipeline_name,\n    origin.update_id AS pipeline_update_id,\n    FROM_JSON(details, 'struct<update_progress: struct<state: string>>').update_progress.state AS pipeline_update_status,\n    timestamp,\n    ROW_NUMBER() OVER (PARTITION BY origin.update_id ORDER BY timestamp DESC) AS rn\n  FROM event_log_raw\n  WHERE event_type = 'update_progress'\n  QUALIFY rn = 1\n),\nupdate_durations AS (\n  SELECT\n    origin.pipeline_id AS pipeline_id,\n    origin.pipeline_name AS pipeline_name,\n    origin.update_id AS pipeline_update_id,\n    MIN(CASE WHEN event_type = 'create_update' THEN timestamp END) AS start_time,\n    COALESCE(\n      MAX(CASE\n        WHEN event_type = 'update_progress'\n         AND FROM_JSON(details, 'struct<update_progress: struct<state: string>>').update_progress.state IN ('COMPLETED', 'FAILED', 'CANCELED')\n        THEN timestamp\n      END),\n      current_timestamp()\n    ) AS end_time\n  FROM event_log_raw\n  WHERE event_type IN ('create_update', 'update_progress')\n    AND origin.update_id IS NOT NULL\n  GROUP BY origin.pipeline_id, origin.pipeline_name, origin.update_id\n  HAVING start_time IS NOT NULL\n)\nSELECT\n  s.pipeline_id,\n  s.pipeline_name,\n  s.pipeline_update_id,\n  d.start_time,\n  d.end_time,\n  CASE\n    WHEN d.start_time IS NOT NULL AND d.end_time IS NOT NULL THEN\n      ROUND(TIMESTAMPDIFF(MILLISECOND, d.start_time, d.end_time) / 1000.0)\n    ELSE NULL\n  END AS duration_seconds,\n  s.pipeline_update_status\nFROM last_status_per_update s\nJOIN update_durations d\n  ON s.pipeline_id = d.pipeline_id AND s.pipeline_update_id = d.pipeline_update_id"
    },
    {
      "name": "flow_metrics",
      "displayName": "Flow progress metrics",
      "query": "WITH event_log_raw AS (\n  SELECT * FROM actuarial_claim_streaming_etl_event_log\n),\nflow_progress_raw AS (\n  SELECT\n    origin.pipeline_name AS pipeline_name,\n    origin.pipeline_id AS pipeline_id,\n    origin.flow_name AS table_name,\n    origin.update_id AS update_id,\n    timestamp,\n    CAST(details:flow_progress.status AS STRING) AS status,\n    TRY_CAST(details:flow_progress.metrics.num_output_rows AS BIGINT) AS num_output_rows,\n    TRY_CAST(details:flow_progress.data_quality.dropped_records AS BIGINT) AS num_expectation_dropped_rows\n  FROM event_log_raw\n  WHERE event_type = 'flow_progress'\n    AND origin.flow_name IS NOT NULL\n    AND origin.flow_name != 'pipelines.flowTimeMetrics.missingFlowName'\n)\nSELECT\n  pipeline_name,\n  pipeline_id,\n  update_id,\n  table_name,\n  MIN(CASE WHEN status IN ('STARTING', 'RUNNING', 'COMPLETED') THEN timestamp END) AS start_timestamp,\n  MAX(CASE WHEN status IN ('STARTING', 'RUNNING', 'COMPLETED') THEN timestamp END) AS end_timestamp,\n  MAX_BY(status, timestamp) FILTER (\n    WHERE status IN ('COMPLETED', 'FAILED', 'CANCELLED', 'EXCLUDED', 'SKIPPED', 'STOPPED', 'IDLE')\n  ) AS final_status,\n  SUM(COALESCE(num_output_rows, 0)) AS total_output_records,\n  MAX(COALESCE(num_expectation_dropped_rows, 0)) AS total_expectation_dropped_records,\n  CASE\n    WHEN MIN(CASE WHEN status IN ('STARTING', 'RUNNING', 'COMPLETED') THEN timestamp END) IS NOT NULL\n     AND MAX(CASE WHEN status IN ('STARTING', 'RUNNING', 'COMPLETED') THEN timestamp END) IS NOT NULL THEN\n      ROUND(TIMESTAMPDIFF(\n        MILLISECOND,\n        MIN(CASE WHEN status IN ('STARTING', 'RUNNING', 'COMPLETED') THEN timestamp END),\n        MAX(CASE WHEN status IN ('STARTING', 'RUNNING', 'COMPLETED') THEN timestamp END)\n      ) / 1000.0)\n    ELSE NULL\n  END AS duration_seconds\nFROM flow_progress_raw\nGROUP BY pipeline_name, pipeline_id, update_id, table_name"
    },
    {
      "name": "expectation_metrics",
      "displayName": "Expectation metrics",
      "query": "WITH event_log_raw AS (\n  SELECT * FROM actuarial_claim_streaming_etl_event_log\n),\nexpectations_parsed AS (\n  SELECT\n    origin.update_id AS update_id,\n    explode(\n      from_json(\n        CAST(details:flow_progress.data_quality.expectations AS STRING),\n        'array<struct<name: string, dataset: string, passed_records: int, failed_records: int>>'\n      )\n    ) AS row_expectations\n  FROM event_log_raw\n  WHERE event_type = 'flow_progress'\n    AND details:flow_progress.data_quality.expectations IS NOT NULL\n)\nSELECT\n  update_id,\n  row_expectations.dataset AS dataset,\n  row_expectations.name AS expectation,\n  SUM(row_expectations.passed_records) AS passing_records,\n  SUM(row_expectations.failed_records) AS failing_records\nFROM expectations_parsed\nGROUP BY update_id, row_expectations.dataset, row_expectations.name"
    },
    {
      "name": "error_events",
      "displayName": "Error and warning events",
      "query": "SELECT\n  timestamp,\n  level,\n  event_type,\n  message,\n  origin.pipeline_name AS pipeline_name,\n  origin.update_id AS update_id,\n  origin.flow_name AS flow_name\nFROM actuarial_claim_streaming_etl_event_log\nWHERE level IN ('ERROR', 'WARN')"
    }
  ],
