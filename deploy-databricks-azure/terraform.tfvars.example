# Copy to terraform.tfvars and edit. Do not commit terraform.tfvars.
#   cp terraform.tfvars.example terraform.tfvars
#
# Each person on a shared subscription MUST use a unique prefix
# (e.g. dbx-alice, dbx-bob) so resource groups and workspaces do not collide.

subscription_id = "00000000-0000-0000-0000-000000000000"
prefix          = "dbx-<yourname>"
location        = "eastus"
environment     = "dev"
owner           = "<yourname>"

# Unity Catalog — from bootstrap-unity-catalog (run once by an Account Admin).
# Get databricks_account_id from Account Console → Account settings → Account ID.
databricks_account_id = "00000000-0000-0000-0000-000000000000"
# az account show --query tenantId -o tsv
azure_tenant_id       = "00000000-0000-0000-0000-000000000000"
metastore_id          = "<metastore_id from bootstrap-unity-catalog output>"

# Exactly ONE participant should set this to true to create the shared actuarial
# catalog (bronze/silver/gold) and grants. Everyone else leaves it false.
# When true, also set uc_storage_root + uc_access_connector_id from bootstrap outputs
# (required because the auto-created Azure metastore has no metastore-level storage).
create_actuarial_catalog = false
# uc_storage_root         = "abfss://metastore@<storageaccount>.dfs.core.windows.net/"
# uc_access_connector_id  = "/subscriptions/.../accessConnectors/..."

# Single-node cluster (1× Standard_E4ads_v7). Databricks-supported v7 SKU.
# Note: Standard_E4ds_v7 is NOT supported by Databricks; use E4ads_v7 instead.
node_type_id        = "Standard_E4ads_v7"
driver_node_type_id = "Standard_E4ads_v7"
# autotermination_minutes = 30
# cluster_name            = ""   # empty => "<prefix>-cluster"

# tags = {
#   Team = "data-platform"
# }
